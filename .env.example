# Environment for the Docker stack: `cp .env.example .env && docker compose up --build`
# .env is git-ignored. Every value below is a placeholder, not a credential.
# Running the apps outside Docker uses apps/api/.env and apps/web/.env instead.

# Postgres. Keep the password alphanumeric: it is embedded in DATABASE_URL, so characters
# like @ : / ? would need percent-encoding. `openssl rand -hex 24` is a good source.
POSTGRES_USER=lead_intake
POSTGRES_PASSWORD=lead_intake
POSTGRES_DB=lead_intake
POSTGRES_TEST_DB=lead_intake_test

# Host ports. Only web is published in deployment (see docker-compose.prod.yml).
WEB_PORT=3000
DB_PORT=5435

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Meta app secret, used to verify the X-Hub-Signature-256 header on webhooks.
META_APP_SECRET=replace-with-your-meta-app-secret
# Any string you choose; must match what you enter in the Meta webhook setup form.
META_VERIFY_TOKEN=replace-with-your-own-verify-token

# mock  = deterministic fake lead details, no Meta credentials needed (default)
# graph = fetch real lead details from the Meta Graph API
LEAD_PROVIDER=mock
# Page access token with leads_retrieval. Required only when LEAD_PROVIDER=graph.
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Exposes POST /dev/simulate-lead, which the dashboard's "Simulate Meta lead" button uses.
ENABLE_DEMO_TOOLS=true

# Comma-separated list of allowed browser origins. The dashboard calls the API through the
# same origin, so this only matters for other callers.
CORS_ORIGIN=http://localhost:3000
