# Copy to .env for local overrides: `cp .env.example .env`
# Both values are optional; the defaults below are what the app uses without a .env file.

# Where the browser sends API calls. The default keeps requests same-origin so the Vite dev
# proxy handles them locally and nginx handles them in the deployed stack.
VITE_API_URL=/api

# Dev-server only: where the /api proxy forwards to.
API_PROXY_TARGET=http://localhost:4000
