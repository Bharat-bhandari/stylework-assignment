# Copy to .env and fill in real values: `cp .env.example .env`
# .env is git-ignored. Every value below is a placeholder, not a credential.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Matches the `db` service in the repository root docker-compose.yml.
DATABASE_URL="postgresql://lead_intake:lead_intake@localhost:5435/lead_intake?schema=public"
# Used by `npm test` only. Created alongside the main database by docker/postgres/init.
TEST_DATABASE_URL="postgresql://lead_intake:lead_intake@localhost:5435/lead_intake_test?schema=public"

# Meta app secret, used to verify the X-Hub-Signature-256 header on webhooks.
META_APP_SECRET=replace-with-your-meta-app-secret
# Any string you choose; must match what you enter in the Meta webhook setup form.
META_VERIFY_TOKEN=replace-with-your-own-verify-token

# mock  = deterministic fake lead details, no Meta credentials needed (default)
# graph = fetch real lead details from the Meta Graph API
LEAD_PROVIDER=mock
# Page access token with leads_retrieval. Required only when LEAD_PROVIDER=graph.
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Exposes POST /dev/simulate-lead. Keep false in production.
ENABLE_DEMO_TOOLS=true

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
